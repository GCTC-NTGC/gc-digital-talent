# Read automatically by docker compose (see docker-compose.yml). Not used by the
# api or web apps, which have their own .env files.
#
# Runs the local containers as you rather than as root, so files they generate
# (node_modules, api/vendor, api/storage, generated GraphQL types, ...) are
# yours to edit without sudo.
#
# Create the real file with your own ids:
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" > .env
#
# Without a .env, the containers keep their previous root-owned behaviour.
HOST_UID=1000
HOST_GID=1000
